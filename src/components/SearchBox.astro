---
import type { RecipeCardModel } from "../types/recipe";

type Props = { recipes: RecipeCardModel[] };
const { recipes } = Astro.props;
---

<div class="search-shell" data-search>
  <span class="search-shell__icon" aria-hidden="true">⌕</span>
  <label class="sr-only" for="site-search">Search recipes</label>
  <input
    id="site-search"
    type="search"
    name="q"
    placeholder="Search recipes, ingredients…"
    autocomplete="off"
    data-search-input
  />
  <div class="search-results" data-search-results hidden role="listbox" aria-label="Search results"></div>
  <script id="search-index" type="application/json" set:html={JSON.stringify(recipes)} />
</div>

<script>
  import { searchRecipes } from "../lib/search";
  import type { RecipeCardModel } from "../types/recipe";

  const root = document.querySelector("[data-search]");
  const input = root?.querySelector<HTMLInputElement>("[data-search-input]");
  const panel = root?.querySelector<HTMLElement>("[data-search-results]");
  const raw = document.getElementById("search-index")?.textContent ?? "[]";
  const recipes = JSON.parse(raw) as RecipeCardModel[];

  if (root && input && panel) {
    let timer = 0;
    let selected = -1;

    const hide = () => {
      panel.hidden = true;
      selected = -1;
    };

    const render = (query: string) => {
      const matches = searchRecipes(recipes, query).slice(0, 8);
      if (!query.trim()) {
        hide();
        return;
      }

      if (matches.length === 0) {
        panel.hidden = false;
        const safe = query.replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] ?? char);
        panel.innerHTML = `<p class="empty" style="margin:0">No recipes match “${safe}”. <button type="button" class="button-ghost" data-clear-search>Clear search</button></p>`;
        panel.querySelector("[data-clear-search]")?.addEventListener("click", () => {
          input.value = "";
          hide();
          input.focus();
        });
        return;
      }

      panel.hidden = false;
      panel.innerHTML = matches
        .map((recipe, index) => {
          const meta = [recipe.cuisine, recipe.mealTypes?.[0]].filter(Boolean).join(" · ");
          return `<a class="search-result" role="option" href="/recipes/${recipe.slug}/" data-index="${index}">
            ${recipe.image ? `<img src="/images/recipes/${recipe.image}" alt="" width="52" height="39" />` : `<div class="placeholder-thumb placeholder">${recipe.title.charAt(0)}</div>`}
            <div><strong>${recipe.title}</strong><span>${meta}</span></div>
          </a>`;
        })
        .join("");
      selected = -1;
    };

    const debounceRender = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => render(input.value), 180);
    };

    input.addEventListener("input", debounceRender);
    input.addEventListener("focus", () => {
      if (input.value.trim()) render(input.value);
    });
    input.addEventListener("keydown", (event) => {
      const options = [...panel.querySelectorAll<HTMLAnchorElement>(".search-result")];
      if (event.key === "Escape") {
        hide();
        input.blur();
        return;
      }
      if (event.key === "ArrowDown") {
        event.preventDefault();
        selected = Math.min(options.length - 1, selected + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        selected = Math.max(0, selected - 1);
      } else if (event.key === "Enter" && selected >= 0 && options[selected]) {
        event.preventDefault();
        options[selected].click();
        return;
      } else {
        return;
      }
      options.forEach((option, index) => option.setAttribute("aria-selected", String(index === selected)));
      options[selected]?.scrollIntoView({ block: "nearest" });
    });

    document.addEventListener("click", (event) => {
      if (!root.contains(event.target as Node)) hide();
    });
  }
</script>
